# ── Frontend (baked into dist/ at `npm run build` — needed for Hostinger) ──
# Supabase → Project Settings → API Keys
# Prefer the new Publishable key (sb_publishable_...). Legacy anon JWT still works.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ── Not used by the website build (CI / local Supabase CLI only) ───────────
# Same names as GitHub Actions secrets for auto db push / function deploy.
# Do NOT prefix these with VITE_ (they must never ship in the static site).

# Supabase → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=

# Supabase → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# Store as Supabase Edge Function secrets (or set API key in /admin/kontakt):
# BREVO_API_KEY — optional fallback if admin API key is empty
# SITE_URL — public site origin, e.g. https://lincarnica.hr (unsubscribe links)
BREVO_API_KEY=
SITE_URL=
